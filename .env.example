# ============================================================================
# .env.example  —  a TEMPLATE of the settings this project reads.
#
# HOW TO USE:
#   1. Copy this file and rename the copy to ".env"
#   2. Fill in / change values as needed
#   3. NEVER commit the real ".env" to git (it can hold secrets)
#
# Everything here has a safe default so the project runs out-of-the-box
# in local + mock mode.
# ============================================================================

# --- Which LLM provider to use for REASONING: "groq" | "anthropic" | "openai" | "ollama"
LLM_PROVIDER=groq

# --- Groq (fast cloud, free tier) settings ---------------------------------
# Get a FREE key at: https://console.groq.com/keys  -> paste it below.
GROQ_API_KEY=
# Reasoning model. "versatile" = smarter; "instant" = lowest latency.
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant   # <- uncomment for max speed / cheapest

# --- Embeddings for RAG (LOCAL + FREE via FastEmbed; Groq has no embeddings) -
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Other providers (only if you switch LLM_PROVIDER later) ----------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama (local) fallback settings, used only if LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- GitHub access: "mock" (local fake) or "real" --------------------------
GITHUB_MODE=mock
# Only needed when GITHUB_MODE=real. Make one at github.com > Settings >
# Developer settings > Personal access tokens (requires 'repo' scope).
GITHUB_TOKEN=
# Target repository when GITHUB_MODE=real in format "owner/repo" (e.g. "octocat/Hello-World")
GITHUB_REPO=owner/repo

# --- RAG settings ----------------------------------------------------------
# Where the vector database is stored on disk.
VECTOR_DB_DIR=.vectordb
# How many code chunks to retrieve per query (small = fewer tokens = cheaper).
RAG_TOP_K=4

